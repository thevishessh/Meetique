DATABASE_URL="postgresql://meetique:meetique@localhost:5433/meetique?schema=public"
# Neon / hosted Postgres: the direct (unpooled) URL, used for migrations and seeding
DIRECT_URL=""
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
APP_URL="http://localhost:3001"
RESEND_API_KEY=""
EMAIL_FROM="Meetique <onboarding@resend.dev>"

# Seed profile for "npm run db:seed": cu-unnao | demo
SEED_PROFILE="cu-unnao"
# Single-client mode (leave empty for multi-organization mode)
CLIENT_ORG_SLUG="cu-unnao"
ALLOW_ORG_SIGNUP="false"
# Internal mode: only signed-in staff can book
PUBLIC_BOOKING="false"
NEXT_PUBLIC_APP_NAME="CU Meetings"
NEXT_PUBLIC_APP_TAGLINE="Staff meeting booking & immediate meetings."
CLIENT_INITIAL_PASSWORD="change-me-before-seeding"

# Phone / browser push alerts. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:it-admin@your-campus-domain"
# Optional: secret for POST /api/cron/tick if you run reminders from an external cron
CRON_SECRET=""
# Set to true to disable the built-in reminder / auto no-show job
DISABLE_JOBS="false"

# Security
# true only behind a reverse proxy (nginx) that overwrites X-Real-IP; enables the per-network login limit
TRUST_PROXY="false"
# Local testing only: show the password-reset link in the response when email is not configured
DEV_SHOW_RESET_LINK="false"
