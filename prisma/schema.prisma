// Meetique — multi-organization appointment, QR token & queue management.
// All timestamps are stored in UTC (timestamptz). Each organization keeps its own IANA timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // organization super admin
  OFFICER // appointment host
  RECEPTIONIST // token operator
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  WALK_IN
}

enum BlockKind {
  UNAVAILABLE // holiday, leave, meeting, temporary break
  AVAILABLE // override: replaces the weekly hours for that period
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  shortCode String   @map("short_code") // used in token numbers, e.g. ABC
  timezone  String   @default("Asia/Kolkata")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  users         User[]
  departments   Department[]
  visitors      Visitor[]
  appointments  Appointment[]
  tokenCounters TokenCounter[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String   @map("password_hash")
  role           Role
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  officerProfile OfficerProfile?
  logs           AppointmentLog[]

  @@index([organizationId, role])
  @@map("users")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  officers     OfficerProfile[]

  @@unique([organizationId, name])
  @@map("departments")
}

model OfficerProfile {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  organizationId String  @map("organization_id")
  departmentId   String? @map("department_id")
  designation    String
  bio            String?
  location       String? // room / cabin shown on the token slip

  // Slot engine settings
  slotDurationMin   Int     @default(15) @map("slot_duration_min")
  bufferMin         Int     @default(5) @map("buffer_min")
  capacityPerSlot   Int     @default(1) @map("capacity_per_slot")
  maxPerDay         Int?    @map("max_per_day")
  advanceBookingDays Int    @default(30) @map("advance_booking_days")
  minNoticeMin      Int     @default(60) @map("min_notice_min")
  allowSameDay      Boolean @default(true) @map("allow_same_day")
  isBookable        Boolean @default(true) @map("is_bookable")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workingHours WorkingHour[]
  blocks       AvailabilityBlock[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("officer_profiles")
}

/// Weekly recurring availability. weekday: 1 = Monday ... 7 = Sunday (ISO).
/// Times are "HH:mm" in the organization's timezone.
model WorkingHour {
  id         String  @id @default(cuid())
  officerId  String  @map("officer_id")
  weekday    Int
  startTime  String  @map("start_time")
  endTime    String  @map("end_time")
  breakStart String? @map("break_start")
  breakEnd   String? @map("break_end")

  officer OfficerProfile @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([officerId, weekday])
  @@map("working_hours")
}

model AvailabilityBlock {
  id        String    @id @default(cuid())
  officerId String    @map("officer_id")
  kind      BlockKind @default(UNAVAILABLE)
  startAt   DateTime  @map("start_at") @db.Timestamptz
  endAt     DateTime  @map("end_at") @db.Timestamptz
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  officer OfficerProfile @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@index([officerId, startAt])
  @@map("availability_blocks")
}

model Visitor {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String
  email          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([organizationId, phone])
  @@map("visitors")
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  visitorId      String            @map("visitor_id")
  officerId      String            @map("officer_id")
  startAt        DateTime          @map("start_at") @db.Timestamptz
  endAt          DateTime          @map("end_at") @db.Timestamptz
  /// Seat inside a slot (1..capacity). Protected by a Postgres exclusion constraint.
  seatNo         Int               @default(1) @map("seat_no")
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(ONLINE)
  purpose        String?
  notes          String?
  /// Secret for the visitor's manage link (separate from the QR secret).
  manageCode     String            @unique @map("manage_code")
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz
  startedAt      DateTime?         @map("started_at") @db.Timestamptz
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor       Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  officer       OfficerProfile   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  tokens        Token[]
  logs          AppointmentLog[]
  notifications Notification[]

  @@index([officerId, startAt])
  @@index([organizationId, startAt])
  @@map("appointments")
}

model Token {
  id            String    @id @default(cuid())
  appointmentId String    @map("appointment_id")
  tokenNumber   String    @unique @map("token_number") // e.g. ABC-2026-000124
  qrSecret      String    @unique @map("qr_secret") // random, no personal data
  isActive      Boolean   @default(true) @map("is_active")
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("tokens")
}

/// Per-organization, per-year sequence used for token numbers.
model TokenCounter {
  organizationId String @map("organization_id")
  year           Int
  lastValue      Int    @default(0) @map("last_value")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@map("token_counters")
}

model AppointmentLog {
  id            String             @id @default(cuid())
  appointmentId String             @map("appointment_id")
  oldStatus     AppointmentStatus? @map("old_status")
  newStatus     AppointmentStatus  @map("new_status")
  actorId       String?            @map("actor_id")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("appointment_logs")
}

model Notification {
  id            String              @id @default(cuid())
  appointmentId String              @map("appointment_id")
  channel       NotificationChannel
  type          String // BOOKED, CANCELLED, RESCHEDULED
  recipient     String
  status        NotificationStatus  @default(PENDING)
  error         String?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("notifications")
}
